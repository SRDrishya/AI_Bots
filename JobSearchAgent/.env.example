# Google Gemini API (optional — falls back to local TF-IDF & skill matching if omitted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order if the main model is overloaded or unavailable
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite

# Anthropic Claude (optional — https://console.anthropic.com/ → API keys; paid per use)
ANTHROPIC_API_KEY=
# Writing: cover letters, tailored resumes, company research ($4 / $20 per million input / output tokens)
ANTHROPIC_MODEL=claude-opus-5-5
# High-volume extraction: resume parsing and job match scoring ($0.10 / $0.50 per million tokens)
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

# Which AI to use first: gemini (default) or anthropic. If it fails (quota, rate limit,
# overload) and the other one has a key, that request switches to the other automatically.
AI_PROVIDER=gemini

# Adzuna API (optional — https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# JSearch via RapidAPI (optional — https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch)
RAPIDAPI_KEY=

# SerpAPI Google Jobs (optional — https://serpapi.com/)
SERPAPI_KEY=

# Server settings
HOST=127.0.0.1
PORT=8000
