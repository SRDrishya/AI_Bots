# Google Gemini API (optional — falls back to local TF-IDF & skill matching if omitted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order if the main model is overloaded or unavailable
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite

# Adzuna API (optional — https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# JSearch via RapidAPI (optional — https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch)
RAPIDAPI_KEY=

# SerpAPI Google Jobs (optional — https://serpapi.com/)
SERPAPI_KEY=

# Server settings
HOST=127.0.0.1
PORT=8000
