# At least one AI key is required. Gemini is used first, Claude as the fallback.
# Gemini: https://aistudio.google.com/apikey  (Google Search grounding finds real interview questions)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order if the main model is overloaded or unavailable
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite

# Anthropic Claude: https://console.anthropic.com  (uses Claude's web search tool)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

# Embeddings for semantic search / duplicate removal (LangChain + Chroma). Needs GEMINI_API_KEY.
EMBEDDING_MODEL=models/gemini-embedding-2

# gemini (default) or claude: which provider to try first
AI_PROVIDER=gemini

# How many questions a full build aims for per technology
QUESTIONS_PER_TECH=100

HOST=127.0.0.1
PORT=8010
